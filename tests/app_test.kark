func test_txn_record_fields() {
    let rec = "TXN|1|INCOME|5000|1"
    let f = split(rec, "|")
    assert_eq(len(f), 5)
    assert_eq(f[0], "TXN")
    assert_eq(f[2], "INCOME")
    assert_eq(int(f[3]), 5000)
    assert_eq(f[4], "1")
}

func test_posted_balance_totals() {
    let recs = ["TXN|1|INCOME|5000|1", "TXN|2|EXPENSE|1200|1", "TXN|3|INCOME|3000|1"]
    let income = 0
    let expense = 0
    let i = 0
    while (i < len(recs)) {
        let f = split(recs[i], "|")
        if (f[4] == "1") {
            if (f[2] == "INCOME") { income = income + int(f[3]) }
            if (f[2] == "EXPENSE") { expense = expense + int(f[3]) }
        }
        i = i + 1
    }
    assert_eq(income, 8000)
    assert_eq(expense, 1200)
    assert_eq(income - expense, 6800)
}

func test_unposted_excluded_and_named_records() {
    let recs = ["TXN|1|INCOME|5000|0", "TXN|2|EXPENSE|900|1"]
    let posted = 0
    let i = 0
    while (i < len(recs)) {
        let f = split(recs[i], "|")
        if (f[4] == "1") { posted = posted + int(f[3]) }
        i = i + 1
    }
    assert_eq(posted, 900)
    let org = split("ORG|Karkain Industries", "|")
    let dept = split("DEPT|Engineering", "|")
    assert_eq(org[0], "ORG")
    assert_eq(dept[1], "Engineering")
}
